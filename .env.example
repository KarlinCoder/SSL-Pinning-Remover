# Interfaz del host donde se publica el puerto.
# 0.0.0.0 = accesible desde fuera (simple, pero menos seguro).
# 127.0.0.1 = solo local, ideal si usas Caddy/Nginx como proxy inverso.
APP_BIND=0.0.0.0

# Puerto público en el host (la app escucha en el 3000 dentro del contenedor).
APP_PORT=3000

# Contraseña para entrar en la web. Si se deja vacía, no hay login.
# En una VPS pública configúrala SIEMPRE.
APP_PASSWORD=

# Secreto para firmar la cookie de sesión. Usa una cadena larga y aleatoria.
# Ejemplo: openssl rand -hex 32
SESSION_SECRET=

# Pon true si sirves la app por HTTPS (recomendado).
COOKIE_SECURE=false

# Pon true si estás detrás de Caddy, Nginx, Traefik u otro proxy inverso.
TRUST_PROXY=false

# Límites del servicio.
MAX_APK_MB=1024
MAX_CONCURRENT_JOBS=1
MAX_QUEUE_LENGTH=8
JOB_TTL_MIN=60
JOB_TIMEOUT_MIN=45
MAX_LOG_LINES=2000

# Seguridad de descargas.
# false = solo destinos públicos (recomendado en internet).
ALLOW_PRIVATE_URLS=false
ALLOWED_PORTS=80,443

# Memoria máxima de la JVM usada por apktool/uber-apk-signer.
JAVA_MAX_HEAP_MB=2048

# Opción avanzada: hace que la APK resultante sea debuggable.
MAKE_DEBUGGABLE=false

# Certificado extra (PEM o DER) para añadirlo a la network security config.
# La ruta debe existir dentro del contenedor. Ejemplo:
#   1. Descomenta el volumen de ejemplo en docker-compose.yml.
#   2. Copia tu certificado a ./mitmproxy-ca-cert.pem.
#   3. Descomenta y ajusta:
# EXTRA_CA_PATH=/certs/mitmproxy-ca-cert.pem
